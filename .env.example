# ==============================================================================
# Configuración del Bot de Telegram + LLM Local (OnePlus 2)
# Copia este archivo a .env y rellena tus valores:  cp .env.example .env
# ==============================================================================

# --- Telegram ---
TELEGRAM_BOT_TOKEN=PEGA_AQUI_TU_TOKEN_DE_BOTFATHER

# Lista separada por comas de IDs de chats/grupos autorizados (ej: -1001234567890,-1009876543210).
# Déjalo vacío solo inicialmente para obtener los IDs con el comando /id.
ALLOWED_CHAT_IDS=

# Tu ID numérico de usuario de Telegram (obtenible con @userinfobot).
# Permite usar /status y /config para ajustar probabilidades en caliente.
ADMIN_USER_ID=

# --- Motor de Inferencia (llama-server local) ---
LLAMA_BASE_URL=http://127.0.0.1:8080
LLM_TIMEOUT_SECONDS=45
MAX_TOKENS=120
TEMPERATURE=0.8
TOP_P=0.9
REPEAT_PENALTY=1.15

# --- Prompts del Sistema (mantener cortos para acelerar el Snapdragon 810) ---
SYSTEM_PROMPT=Eres un participante más en un grupo de Telegram en español. Responde de forma muy breve (1 a 3 frases), natural, directa y sin formalismos innecesarios.
SUMMARY_INTERVENTION_INSTRUCTION=Haz un comentario breve (1 a 2 frases) reaccionando de forma general al tema que se está comentando recientemente en el grupo, sin limitarte solo al último mensaje.
DELAYED_REPLY_INSTRUCTION=Retoma con naturalidad el mensaje anterior indicado haciendo un comentario breve (1 a 2 frases), como alguien que acaba de leer ese mensaje del grupo un rato después.

# --- Gestión de Contexto ---
# Mensajes guardados en memoria por grupo (sirven de pool para respuestas diferidas)
MAX_CONTEXT_MESSAGES=15
# Cuántos mensajes recientes se envían realmente al LLM (bajo para caber en -c 1024)
PROMPT_CONTEXT_MESSAGES=6
# Límite de caracteres por mensaje almacenado
MAX_MESSAGE_CHARS=280

# --- Modos de Intervención (todos ajustables también con /config) ---
# 1. Respuesta directa: menciones (@bot), replies al bot y chats privados
DIRECT_REPLY_ENABLED=true
# Palabras clave opcionales separadas por coma que activan respuesta directa (coincidencia por palabra completa)
KEYWORDS=ia,romino

# Pausa mínima (segundos) entre dos intervenciones no directas en un mismo grupo
GROUP_COOLDOWN_SECONDS=15

# 2. Intervención aleatoria inmediata al llegar un mensaje nuevo (0.0 a 1.0)
RANDOM_REPLY_PROBABILITY=0.05

# 3. Proporción de intervenciones aleatorias que comentan el resumen reciente del grupo
#    en lugar de responder al último mensaje (0.0 = siempre último msg, 1.0 = siempre resumen)
SUMMARY_INTERVENTION_RATIO=0.40

# 4. Respuestas diferidas a mensajes pasados (tarea periódica en segundo plano)
DELAYED_REPLY_ENABLED=true
# Cada cuántos segundos se evalúa si lanzar una respuesta diferida
DELAYED_REPLY_CHECK_INTERVAL_SECONDS=300
# Probabilidad por ciclo de intervenir en un grupo elegible (0.0 a 1.0)
DELAYED_REPLY_PROBABILITY=0.15
# Ventana de antigüedad (segundos) del mensaje pasado a responder (por defecto: 5 min a 2 h)
DELAYED_REPLY_MIN_AGE_SECONDS=300
DELAYED_REPLY_MAX_AGE_SECONDS=7200
# Tiempo mínimo entre dos intervenciones diferidas en un mismo grupo (por defecto: 30 min)
DELAYED_REPLY_COOLDOWN_SECONDS=1800
# Proporción de intervenciones diferidas que comentan el resumen del grupo en vez de hacer reply a un mensaje concreto
DELAYED_SUMMARY_RATIO=0.25

# --- Control de Concurrencia ---
# Si es true, avisa en el chat cuando una mención directa coincide con otra inferencia en curso.
# Las intervenciones aleatorias y diferidas siempre se descartan silenciosamente si el motor está ocupado.
NOTIFY_WHEN_BUSY=false

# --- Síntesis de Voz Local (Suno Bark vía bark.cpp GGML Q4_0) ---
# Si bark.cpp o el modelo no están instalados, el bot responde automáticamente en texto sin fallar.
TTS_ENABLED=true
BARK_BIN=~/bin/bark-main
BARK_MODEL_PATH=~/models/bark-small_weights-q4_0.bin
BARK_THREADS=8
BARK_TIMEOUT_SECONDS=180
# Probabilidad de enviar nota de voz en respuestas inmediatas (recomendado bajo por latencia del SD810)
VOICE_REPLY_PROBABILITY=0.10
# Probabilidad de enviar nota de voz en intervenciones diferidas (ideal: nadie espera respuesta al instante)
DELAYED_VOICE_PROBABILITY=0.35
# Límite de caracteres por audio (evita tiempos excesivos en CPU)
TTS_MAX_CHARS=140
# Si es true, adjunta el texto como pie de la nota de voz
TTS_SEND_TEXT_CAPTION=false

# --- Memoria Evolutiva por Grupo e Histórico JSONL ---
MEMORY_ENABLED=true
# Cada cuántos mensajes nuevos de un grupo se actualiza automáticamente su resumen en segundo plano
MEMORY_UPDATE_EVERY_MESSAGES=20
# Longitud máxima (caracteres) de la memoria resumida por grupo (mantiene bajo el consumo de contexto)
MEMORY_MAX_CHARS=450
# Guarda histórico completo de cada grupo en history/chat_<id>.jsonl
ARCHIVE_CHATS_JSONL=true
